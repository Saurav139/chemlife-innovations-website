# ChemLife Website Environment Variables Config Example
# Copy this file to .env.local and configure the values

# YouTube API Integration (For Podcasts playlist)
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_PLAYLIST_ID=UUw9YQ4V85x2n_L3mC0uE7yA # Default Channel Uploads playlist ID for ChemLife

# LinkedIn Company Feed Integration
LINKEDIN_ACCESS_TOKEN=your-linkedin-developer-token-here
LINKEDIN_ORGANIZATION_ID=your-linkedin-company-org-id-here
