# ChemLife Website Environment Variables Config Example
# Copy this file to .env.local and configure the values

# YouTube API Integration (For Podcasts playlist)
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_PLAYLIST_ID=UUw9YQ4V85x2n_L3mC0uE7yA # Default Channel Uploads playlist ID for ChemLife

# LinkedIn Company Feed Integration
LINKEDIN_ACCESS_TOKEN=your-linkedin-developer-token-here
LINKEDIN_ORGANIZATION_ID=your-linkedin-company-org-id-here

# Chatbot (Dr. Kukku and Dr. Mikku). Without both keys the chat pages show the bots as offline.
# On Hostinger, set these in hPanel's environment variables, then redeploy.
# Use an OpenAI key made for this website only, with a monthly budget limit set in the OpenAI dashboard.
OPENAI_API_KEY=your-openai-api-key-here
PINECONE_API_KEY=your-pinecone-api-key-here
# Optional. The index must have been built with OpenAI text-embedding-3-small (1536 dimensions).
PINECONE_INDEX_NAME=chemlife-knowledge
# Optional. Most chat questions answered per day across the whole site (each costs about $0.001).
CHAT_DAILY_LIMIT=3000

# Google Analytics. Optional: the Measurement ID normally goes in src/lib/analytics.ts (GA_ID).
# This overrides it, e.g. to test with a separate GA4 property.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Staging site only (any address other than chemlifeinnovations.com). Set it in the staging site's hPanel
# environment variables to make the site ask for a password. Any user name works.
# STAGING_PASSWORD=choose-a-password
